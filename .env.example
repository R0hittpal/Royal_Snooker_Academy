# ============================================================
# DJANGO
# ============================================================
# Generate a long random value for production.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key

# Keep True for local development.
# Set False only for a properly configured production deployment.
DJANGO_DEBUG=True

# Local development:
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Production example:
# DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com


# ============================================================
# RSA EMAIL / GMAIL SMTP
# ============================================================
RSA_EMAIL_HOST_USER=your-rsa-email@gmail.com
RSA_EMAIL_HOST_PASSWORD=your-gmail-app-password
RSA_DEFAULT_FROM_EMAIL=your-rsa-email@gmail.com
