# ============================================================
# DJANGO
# ============================================================
# Generate a long random value for production.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key

# Keep True for local development.
# Set False only for a properly configured production deployment.
DJANGO_DEBUG=True

# Local development:
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Production example:
# DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=generate-a-long-random-production-secret
# DATABASE_URL=your-render-postgresql-connection-string
# Render also supplies RENDER_EXTERNAL_HOSTNAME for the service hostname.


# ============================================================
# RSA EMAIL / GMAIL SMTP
# ============================================================
RSA_EMAIL_HOST_USER=your-rsa-email@gmail.com
RSA_EMAIL_HOST_PASSWORD=your-gmail-app-password
RSA_DEFAULT_FROM_EMAIL=your-rsa-email@gmail.com

# Optional Brevo delivery configuration. The logo URL must be public.
# RSA_EMAIL_PROVIDER=brevo
# RSA_BREVO_API_KEY=your-brevo-api-key
# RSA_BREVO_SENDER_EMAIL=your-verified-sender@example.com
# RSA_EMAIL_LOGO_URL=https://your-public-domain/static/images/royal_snooker_favicon_under_50kb.png
